# Production default: Stadia hosted Valhalla. Server-side secret only.
# Set the real value in .env.local or your deployment environment; never commit it.
# STADIA_API_KEY=your-local-secret
# Optional: stadia or valhalla. A configured key selects stadia automatically.
# ROUTING_PROVIDER=stadia
# Optional explicit local/private Valhalla provider (no Stadia authentication).
# ROUTING_PROVIDER=valhalla
# VALHALLA_URL=https://your-routing-service.example/route
